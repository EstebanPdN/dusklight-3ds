; Shared indexed GX path. Identity uniform accepts pretransformed J3D clip
; coordinates; legacy J2D uses its viewport/tilt/depth matrix. Preserve input w.
.fvec transform[4]
.constf constants(0.0, 1.0, 0.0, 0.0)
.out outpos position
.out outcolor color
.out outtex texcoord0.st
.out - texcoord0w outtex.p
.out outtex1 texcoord1
.out outtex2 texcoord2
.proc main
    mov r0, v0
    dp4 r1.x, transform[0], r0
    dp4 r1.y, transform[1], r0
    dp4 r1.z, transform[2], r0
    dp4 r1.w, transform[3], r0
    ; texcoord0 carries its divisor q in the third component: the PICA divides
    ; per pixel when unit 0 is in projection mode and ignores it in 2D mode.
    mov r2, v2
    mov r2.z, v5.x
    ; Outputs: the console PICA takes each component of each output register
    ; exactly once. One left unwritten stopped it on every vertex (gx_rigid,
    ; 2026-11-13); a later second write is ignored or stops it too (3dbrew,
    ; GPU/Pitfalls). Every program therefore builds its outputs in registers
    ; and writes each output once, whole (Tools/3ds/check_pica_shader.py).
    mov outpos, r1
    mov outcolor, v1
    mov outtex, r2
    mov outtex1, v3
    mov outtex2, v4
    end
.end
