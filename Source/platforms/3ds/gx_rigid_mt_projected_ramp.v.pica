; Variant of gx_rigid_mt.v.pica (runtime/gx_vertex_variant.hpp): lit, unit 0
; projected from the position and divided here (role 2, u[92].z = 0), unit 1
; a texture coordinate (role 1), unit 2 the fog ramp coordinate (role 0.5),
; linear fog with the range adjustment (u[12].xyz = 1, 1, 0): the terrain of
; the fields and villages. The colour tests of the material stay;
; gx_rigid_mt_parts.v.pica holds the shared steps.
.fvec u[94]
.ivec lightLoop
.constf k(0.0,1.0,0.5,9.0)
.constf epsilon(0.0000000001,0.000001,0.99609375,0.001953125)
.out outpos position
.out outcolor color
.out outtex texcoord0.st
.out - texcoord0w outtex.p
.out outtex1 texcoord1
.out outtex2 texcoord2
.entry projectedRamp
.proc projectedRamp
    mov r15, k.xxxx
    mov r14, v0
    mov r14.w, k.y
    mova a0.xy, v4.xy
    dp4 r0.x, u[a0.x+0], r14
    dp4 r0.y, u[a0.x+1], r14
    dp4 r0.z, u[a0.x+2], r14
    mov r0.w, k.y
    dp4 r2.x, u[6], r0
    dp4 r2.y, u[7], r0
    dp4 r2.z, u[8], r0
    dp4 r2.w, u[9], r0
    call litColour
    mov r12.xy, v2.xy
    mov r12.zw, k.yy
    mov r13, v5
    dp4 r4.x, u[85], r12
    dp4 r4.y, u[86], r13
    add r6.x, r4.x, r4.y
    dp4 r4.x, u[87], r12
    dp4 r4.y, u[88], r13
    add r6.y, r4.x, r4.y
    mov r6.zw, k.xxxx
    call projectedHere
    mov r5.zw, k.xxyx
    call fogRange
    mul r9.y, epsilon.z, r9.y
    add r9.y, epsilon.w, r9.y
    mov r7.x, r9.y
    mov r7.yzw, k.xzxx
    mov outpos, r2
    mov outcolor, r3
    mov outtex, r5
    mov outtex1, r6
    mov outtex2, r7
    end
.end
