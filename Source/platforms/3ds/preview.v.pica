; Startup texture proof: position and one texture coordinate, no game shader.
.fvec projection[4]
.constf constants(0.0, 1.0, 0.0, 0.0)
.out outpos position
.out outuv texcoord0
.out outcolor color
.proc main
    mov r0.xyz, v0
    mov r0.w, constants.y
    dp4 outpos.x, projection[0], r0
    dp4 outpos.y, projection[1], r0
    dp4 outpos.z, projection[2], r0
    dp4 outpos.w, projection[3], r0
    mov outuv, v1
    mov outcolor, constants.yyyy
    end
.end
