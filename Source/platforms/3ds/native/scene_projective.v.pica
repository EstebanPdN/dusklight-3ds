; Native ABI64. Link scene_shared.pica after this file (Picasso .nodvle).
.fvec u[90]
.ivec lightLoop
.alias k c90
.alias q c91
.setf c90(0.0,1.0,0.00392156862745098,0.000001)
.setf c91(0.5,9.0,0.125,-8.0)
.setf c92(2.0,3.0,4.0,8.0)
.setf c93(0.99609375,0.001953125,5.0,6.0)
.in nativePosition v0
.in nativeNormal v1
.in nativeUv0 v2
.in nativeUv1 v3
.in nativeUv2 v4
.in nativeColor v5
.in nativeColor1 v6
.in nativeBoneRows v7
.in nativeWeights v8
.out outpos position
.out outcolor color
.out outtex0 texcoord0.st
.out - texcoord0w outtex0.p
.out outtex1 texcoord1
.out outtex2 texcoord2
.proc main
    mov r15, k.xxxx
    mov r0, k.xxxx
    mov r1, k.xxxx
    mov r14.xyz, v0
    mov r14.w, k.y
    cmp v8.x, gt, gt, r15.x
    ifc cmp.x
        mova a0.x, v7.x
        mul r3.x, k.z, v8.x
        call influence
    .end
    cmp v8.y, gt, gt, r15.x
    ifc cmp.x
        mova a0.x, v7.y
        mul r3.x, k.z, v8.y
        call influence
    .end
    cmp v8.z, gt, gt, r15.x
    ifc cmp.x
        mova a0.x, v7.z
        mul r3.x, k.z, v8.z
        call influence
    .end
    cmp v8.w, gt, gt, r15.x
    ifc cmp.x
        mova a0.x, v7.w
        mul r3.x, k.z, v8.w
        call influence
    .end
    call project
    call colors
    call passthrough
    call affine
    call projective
    call fog
    call carrier
    end
.end
